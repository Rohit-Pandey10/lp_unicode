{
  "info": {
    "name": "Task 3 - Auction Management API",
    "description": "Postman Collection for Task 3: Auction Management, Cloud Media Uploads, and Structured Logging.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Register Seller",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Rohit Pandey\",\n  \"email\": \"rohit.pandey@gmail.com\",\n  \"password\": \"Password123!\",\n  \"role\": \"Seller\"\n}"
            },
            "url": "http://localhost:5001/api/auth/register"
          }
        },
        {
          "name": "Login Seller",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"rohit.pandey@gmail.com\",\n  \"password\": \"Password123!\",\n  \"role\": \"Seller\"\n}"
            },
            "url": "http://localhost:5001/api/auth/login"
          }
        }
      ]
    },
    {
      "name": "2. Auction Management",
      "item": [
        {
          "name": "Create Auction (Multipart)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer <YOUR_SELLER_TOKEN>"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "title", "value": "Apple iPhone 15 Pro Max 256GB Natural Titanium", "type": "text" },
                { "key": "description", "value": "Brand new sealed Apple iPhone 15 Pro Max, 256GB storage, Natural Titanium finish with 1-year official warranty.", "type": "text" },
                { "key": "category", "value": "Smartphones", "type": "text" },
                { "key": "startingPrice", "value": "1199", "type": "text" },
                { "key": "startTime", "value": "2026-11-01T10:00:00.000Z", "type": "text" },
                { "key": "endTime", "value": "2026-11-20T18:00:00.000Z", "type": "text" },
                { "key": "images", "type": "file", "src": "" }
              ]
            },
            "url": "http://localhost:5001/api/auctions"
          }
        },
        {
          "name": "Create Auction (JSON)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              {
                "key": "Authorization",
                "value": "Bearer <YOUR_SELLER_TOKEN>"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Sony PlayStation 5 Disc Edition Console\",\n  \"description\": \"PlayStation 5 console bundled with DualSense wireless controller and original box in mint condition.\",\n  \"category\": \"Gaming\",\n  \"startingPrice\": 499,\n  \"startTime\": \"2026-11-01T00:00:00.000Z\",\n  \"endTime\": \"2026-11-25T00:00:00.000Z\",\n  \"images\": [\"https://res.cloudinary.com/demo/image/upload/sample.jpg\"]\n}"
            },
            "url": "http://localhost:5001/api/auctions"
          }
        },
        {
          "name": "Update Own Auction",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              {
                "key": "Authorization",
                "value": "Bearer <YOUR_SELLER_TOKEN>"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Apple iPhone 15 Pro Max 256GB - Free AppleCare Included\",\n  \"startingPrice\": 1250\n}"
            },
            "url": "http://localhost:5001/api/auctions/6aeebe0f45d55d5e5de9ff8b"
          }
        },
        {
          "name": "Admin Update Any Auction",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              {
                "key": "Authorization",
                "value": "Bearer <YOUR_ADMIN_TOKEN>"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Verified listing: Authenticity and warranty verified by platform administrators.\"\n}"
            },
            "url": "http://localhost:5001/api/auctions/6aeebe0f45d55d5e5de9ff8b"
          }
        },
        {
          "name": "Admin Delete Auction",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer <YOUR_ADMIN_TOKEN>"
              }
            ],
            "url": "http://localhost:5001/api/auctions/6aeebe0f45d55d5e5de9ff8b"
          }
        }
      ]
    },
    {
      "name": "3. Browsing & Filtering",
      "item": [
        {
          "name": "Get All Auctions",
          "request": {
            "method": "GET",
            "url": "http://localhost:5001/api/auctions"
          }
        },
        {
          "name": "Filter Auctions by Status (ACTIVE)",
          "request": {
            "method": "GET",
            "url": "http://localhost:5001/api/auctions?status=ACTIVE"
          }
        },
        {
          "name": "Filter Auctions by Category & Price",
          "request": {
            "method": "GET",
            "url": "http://localhost:5001/api/auctions?category=Smartphones&minPrice=1000&maxPrice=2000"
          }
        },
        {
          "name": "Search Auctions",
          "request": {
            "method": "GET",
            "url": "http://localhost:5001/api/auctions?search=iPhone"
          }
        },
        {
          "name": "Get Auction Details by ID",
          "request": {
            "method": "GET",
            "url": "http://localhost:5001/api/auctions/6aeebe0f45d55d5e5de9ff8b"
          }
        }
      ]
    }
  ]
}
